# Configuración de AWS
AWS_REGION=us-east-1

# Proveedor de agente: bedrock | agentcore | ec2
AGENT_PROVIDER=bedrock

# Configuración de Bedrock Agent (usada cuando AGENT_PROVIDER=bedrock)
BEDROCK_AGENT_ID=your_bedrock_agent_id
BEDROCK_AGENT_ALIAS_ID=your_bedrock_agent_alias_id

# Configuración de AgentCore (usada cuando AGENT_PROVIDER=agentcore)
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/MyRuntime-AbCdEfGhIj
AGENTCORE_REGION=us-west-2
AGENTCORE_TIMEOUT_MS=120000

# Configuración de Agent HTTP / EC2 (usada cuando AGENT_PROVIDER=ec2)
AGENT_HTTP_URL=http://3.234.208.1:8081/chat
AGENT_HTTP_TIMEOUT_MS=20000

# Configuración de Connect Customer Profiles
CONNECT_DOMAIN_NAME=your_connect_domain_name
SUMMARY_FIELD=AdditionalInformation

# Transcript logging
CALL_TRANSCRIPT_LOGGING_TABLE=connect_outbound_call_transcript
